<UserControl x:Class="XInputMultiCharacter.Views.PlayerSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XInputMultiCharacter.Views"
             Background="#FF1E1E1E">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Name:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="NameBox" Width="120" Margin="0,0,14,0" TextChanged="NameBox_TextChanged"/>

            <TextBlock Text="Switch Hotkey:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock x:Name="HotkeyText" Width="90" Foreground="Yellow" VerticalAlignment="Center"/>
            <Button Content="Set" Width="45" Margin="4,0,14,0" Click="SetHotkey_Click"/>

            <Button x:Name="ActivateButton" Content="Make Active Now" Click="Activate_Click" Padding="6,2" Margin="0,0,10,0"/>
            <Button Content="Copy Mapping To All Players" Click="CopyToAll_Click" Padding="6,2" Margin="0,0,10,0"/>

            <Border x:Name="ActiveBadge" Background="#FF2E7D32" CornerRadius="4" Padding="8,3" Visibility="Collapsed">
                <TextBlock Text="ACTIVE" Foreground="White" FontWeight="Bold"/>
            </Border>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF141414" Margin="8" CornerRadius="6">
                <local:XboxControllerDiagram x:Name="Diagram" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
            </Border>
            <ScrollViewer Grid.Column="1" Margin="8">
                <StackPanel x:Name="MappingsPanel"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

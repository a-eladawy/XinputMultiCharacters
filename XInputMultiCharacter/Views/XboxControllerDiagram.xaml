<UserControl x:Class="XInputMultiCharacter.Views.XboxControllerDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="260">
    <Canvas Background="Transparent">
        <Path Data="M 40,110 C 40,60 90,40 150,40 L 210,40 C 270,40 320,60 320,110 C 320,170 290,220 250,220 C 220,220 215,180 180,180 C 145,180 140,220 110,220 C 70,220 40,170 40,110 Z"
              Fill="#FF2B2B2B" Stroke="#FF111111" StrokeThickness="2"/>

        <Rectangle Width="18" Height="24" Canvas.Left="60" Canvas.Top="8" Fill="#FF1A1A1A"/>
        <Rectangle x:Name="TriggerLT" Width="18" Height="0" Canvas.Left="60" Canvas.Top="32" Fill="#FF3E8E41"/>
        <Rectangle Width="18" Height="24" Canvas.Left="282" Canvas.Top="8" Fill="#FF1A1A1A"/>
        <Rectangle x:Name="TriggerRT" Width="18" Height="0" Canvas.Left="282" Canvas.Top="32" Fill="#FF3E8E41"/>

        <Rectangle x:Name="BtnLB" Width="50" Height="14" Canvas.Left="55" Canvas.Top="35" RadiusX="4" RadiusY="4" Fill="#FF444444"/>
        <Rectangle x:Name="BtnRB" Width="50" Height="14" Canvas.Left="255" Canvas.Top="35" RadiusX="4" RadiusY="4" Fill="#FF444444"/>

        <Ellipse Width="60" Height="60" Canvas.Left="55" Canvas.Top="70" Fill="#FF1A1A1A" Stroke="#FF444444" StrokeThickness="2"/>
        <Ellipse x:Name="LeftStickCap" Width="36" Height="36" Canvas.Left="67" Canvas.Top="82" Fill="#FF3D3D3D" Stroke="#FF666666" StrokeThickness="1"/>

        <Rectangle x:Name="DPadUp" Width="16" Height="20" Canvas.Left="122" Canvas.Top="140" Fill="#FF555555"/>
        <Rectangle x:Name="DPadDown" Width="16" Height="20" Canvas.Left="122" Canvas.Top="180" Fill="#FF555555"/>
        <Rectangle x:Name="DPadLeft" Width="20" Height="16" Canvas.Left="100" Canvas.Top="162" Fill="#FF555555"/>
        <Rectangle x:Name="DPadRight" Width="20" Height="16" Canvas.Left="140" Canvas.Top="162" Fill="#FF555555"/>

        <Ellipse x:Name="BtnBack" Width="16" Height="16" Canvas.Left="150" Canvas.Top="95" Fill="#FF555555"/>
        <Ellipse x:Name="BtnGuide" Width="30" Height="30" Canvas.Left="165" Canvas.Top="105" Fill="#FF2E7D32" Stroke="Black" StrokeThickness="1"/>
        <Ellipse x:Name="BtnStart" Width="16" Height="16" Canvas.Left="195" Canvas.Top="95" Fill="#FF555555"/>

        <Ellipse x:Name="BtnY" Width="26" Height="26" Canvas.Left="255" Canvas.Top="70" Fill="#FFB8860B" Stroke="Black" StrokeThickness="1"/>
        <Ellipse x:Name="BtnX" Width="26" Height="26" Canvas.Left="228" Canvas.Top="97" Fill="#FF1E5FA8" Stroke="Black" StrokeThickness="1"/>
        <Ellipse x:Name="BtnB" Width="26" Height="26" Canvas.Left="282" Canvas.Top="97" Fill="#FF9E1B1B" Stroke="Black" StrokeThickness="1"/>
        <Ellipse x:Name="BtnA" Width="26" Height="26" Canvas.Left="255" Canvas.Top="124" Fill="#FF1E7A1E" Stroke="Black" StrokeThickness="1"/>

        <Ellipse Width="60" Height="60" Canvas.Left="200" Canvas.Top="130" Fill="#FF1A1A1A" Stroke="#FF444444" StrokeThickness="2"/>
        <Ellipse x:Name="RightStickCap" Width="36" Height="36" Canvas.Left="212" Canvas.Top="142" Fill="#FF3D3D3D" Stroke="#FF666666" StrokeThickness="1"/>
    </Canvas>
</UserControl>

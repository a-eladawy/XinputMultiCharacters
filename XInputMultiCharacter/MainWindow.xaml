<Window x:Class="XInputMultiCharacter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XInput Multi-Character Player"
        Height="760" Width="980" Background="#FF141414">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF1E1E1E" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Source:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ModeCombo" Width="130" Margin="0,0,10,0" SelectionChanged="ModeCombo_SelectionChanged"/>
                <ComboBox x:Name="DeviceCombo" Width="220" Margin="0,0,10,0" SelectionChanged="DeviceCombo_SelectionChanged"/>
                <Button Content="Refresh Devices" Click="RefreshDevices_Click" Margin="0,0,16,0" Padding="6,2"/>

                <Button x:Name="ConnectButton" Content="Connect All" Click="ConnectAll_Click" Padding="8,2" Margin="0,0,20,0"/>

                <Border Background="#FF2E7D32" CornerRadius="4" Padding="10,4">
                    <TextBlock x:Name="ActiveLabel" Text="Active: Player 1" Foreground="White" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>
        <TabControl x:Name="Tabs" Margin="4"/>
    </DockPanel>
</Window>
